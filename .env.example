# 复制为 .env 后填写。.env 已在 .gitignore 中，绝不会入库。

# ── 运行环境 ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# ── 数据库 ──────────────────────────────────────────────────
DATABASE_URL=postgres://nm405:nm405@127.0.0.1:5432/nm405
DB_POOL_MAX=10

# ── 会话 ────────────────────────────────────────────────────
# 至少 32 字符。生成：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=请替换为随机生成的至少32位字符串
SESSION_TTL_DAYS=30

# ── 存储（v1 只实现 local 驱动）─────────────────────────────
STORAGE_DIR=./uploads

# ── 图源抓取 ────────────────────────────────────────────────
# 出网代理。**留空 = 直连**；内网出口到 Pixiv / X / 图床的直连通常不通
# （DNS 应答会被污染成无关地址），那种环境下这里必须填。
# 例：SOURCING_PROXY=http://主机:端口
# ⚠️ 具体地址属于内网拓扑，只写在部署机的 .env 里，不要提交进仓库。
SOURCING_PROXY=
SOURCING_TIMEOUT_MS=20000
# 同时在跑的抓取请求数上限。图源多有限流，调高不会更快，只会更容易被拦。
SOURCING_CONCURRENCY=4

# 图源凭据（X 的 auth_token/ct0、Pixiv 的 PHPSESSID 等）的加密密钥。
# 不填则从 SESSION_SECRET 派生 —— 单机够用，但**换 SESSION_SECRET 会让已存的
# 凭据全部解不开**；多机部署或想独立轮换时显式设一个（至少 16 字符）。
CREDENTIAL_KEY=

# 单次导入的上限：按用户抓取时最多取几个作品、一个任务最多几张图。
IMPORT_MAX_WORKS=50
IMPORT_MAX_IMAGES=500
# worker 一个 tick 同时跑几条导入任务；租约 = 任务被抢走后多久允许别人重认领。
IMPORT_BATCH=2
IMPORT_LEASE_MINUTES=15

# ── 前端（仅 frontend 需要）─────────────────────────────────
VITE_API_BASE=/api
