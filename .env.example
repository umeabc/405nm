# 复制为 .env 后填写。.env 已在 .gitignore 中，绝不会入库。

# ── 运行环境 ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# ── 数据库 ──────────────────────────────────────────────────
DATABASE_URL=postgres://nm405:nm405@127.0.0.1:5432/nm405
DB_POOL_MAX=10

# ── 会话 ────────────────────────────────────────────────────
# 至少 32 字符。生成：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=请替换为随机生成的至少32位字符串
SESSION_TTL_DAYS=30

# ── 存储（v1 只实现 local 驱动）─────────────────────────────
STORAGE_DIR=./uploads

# ── 前端（仅 frontend 需要）─────────────────────────────────
VITE_API_BASE=/api
