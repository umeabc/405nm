# 复制为 deploy/.env（已在 .gitignore 中，不会入库）

# ── 镜像 tag（本地构建时用 dev）────────────────────────────
IMAGE_TAG=dev

# ── 数据库 ──────────────────────────────────────────────────
POSTGRES_USER=nm405
POSTGRES_PASSWORD=请替换为强密码
POSTGRES_DB=nm405

# ── 会话（至少 32 字符）─────────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=请替换为随机生成的至少32位字符串
SESSION_TTL_DAYS=30

# ── 对外端口 ────────────────────────────────────────────────
# 默认只绑本机，由宿主机 nginx 反代出去。
# 测试阶段想直接访问可临时改成 0.0.0.0。
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8790

LOG_LEVEL=info
