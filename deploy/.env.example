# 复制为 deploy/.env（已在 .gitignore 中，不会入库）

# ── 镜像 tag（本地构建时用 dev）────────────────────────────
IMAGE_TAG=dev

# ── 数据库 ──────────────────────────────────────────────────
POSTGRES_USER=nm405
POSTGRES_PASSWORD=请替换为强密码
POSTGRES_DB=nm405

# ── 会话（至少 32 字符）─────────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=请替换为随机生成的至少32位字符串
SESSION_TTL_DAYS=30

# ── 对外端口 ────────────────────────────────────────────────
# 默认只绑本机，由宿主机 nginx 反代出去。
# 测试阶段想直接访问可临时改成 0.0.0.0。
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8790

# ── 图源抓取 ────────────────────────────────────────────────
# 出网代理。**留空 = 直连**。
#
# 内网出口常常到不了 Pixiv / X / 图床（那几个域名的 DNS 应答会被污染），
# 那种网络下必须填一个能出去的代理，否则「从链接导入」全线失败。
# 支持 http / https / socks4 / socks5。
#
# ⚠️ 具体地址是内网拓扑，**不要**写进这个文件（仓库是公开的），
#    只写在各部署机自己的 deploy/.env 里。
SOURCING_PROXY=

# 单次抓取超时（毫秒）与并发上限。并发调高会被上游当爬虫。
SOURCING_TIMEOUT_MS=20000
SOURCING_CONCURRENCY=4

# ── AI 机翻 ─────────────────────────────────────────────────
# 模型地址与 Key **不在这里配**：每个用户在「个人资料 → AI 机翻模型」里各配各的
# （谁点谁付费，共享一份 key 会让额度被谁用完无从追查）。这里只管进程级的上限。

# 单次模型调用超时（毫秒）。看图识别比纯文字慢得多，默认 2 分钟。
AI_TIMEOUT_MS=120000
# 模型调用并发。按人计费的通道不适合默默并发。
AI_CONCURRENCY=2
# 送给模型的术语表上限（条）：只带这一批原文里真的出现过的词，长词优先。
AI_GLOSSARY_LIMIT=150
# 一页最多接收多少个识别结果，防止模型吐回一大串噪声把库写满。
AI_MAX_MARKERS=60

LOG_LEVEL=info
